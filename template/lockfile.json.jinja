{
  "dependencies": [
{% if unit_test_library == "gtest" %}
    {
      "name": "googletest",
      "package_name": "GTest",
      "git_repository": "https://github.com/google/googletest.git",
      "git_tag": "v1.17.0",
      "cmake_args": {
        "INSTALL_GTEST": "OFF"
      }
    }
{% elif unit_test_library == "catch2" %}
    {
      "name": "Catch2",
      "package_name": "Catch2",
      "git_repository": "https://github.com/catchorg/Catch2.git",
      "git_tag": "v3.15.2"
    }
{% endif %}
  ]
}
